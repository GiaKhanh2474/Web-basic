# Reference only: PHP does not automatically load .env files.
# Set these in Render > Environment (or pass --env-file to docker run).
APP_ENV=production
PORT=10000
DB_HOST=your-database-host
DB_PORT=3306
DB_DATABASE=cellphones_shop
DB_USERNAME=your-database-user
DB_PASSWORD=replace-in-render-only
DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
DB_AUTO_SETUP=true
